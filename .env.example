# Chat email notifications (server-side only)
RESEND_API_KEY=re_xxxxxxxxx
CHAT_ADMIN_EMAIL=wholesale@example.com
CHAT_FROM_EMAIL=Hi-Five Wholesale <chat@example.com>

# Database
# Local development automatically uses .data/hifive.pglite when DATABASE_URL is omitted.
# Production should use the DigitalOcean Managed PostgreSQL connection string.
DATABASE_URL=
DATABASE_CA_CERT=
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Encryption and authentication secrets (server-side only)
APP_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=hifive_session
BUYER_SESSION_COOKIE_NAME=hifive_buyer_session

# One-time production administrator bootstrap (remove after running npm run admin:seed)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN
BOOTSTRAP_ADMIN_PASSWORD=

# Clover sandbox connectivity (test merchant credentials only)
# Production uses merchant-specific OAuth tokens encrypted in the database.
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
